/dts-v1/;
/plugin/;

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_PWDN	TEGRA234_MAIN_GPIO(AC, 0)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#include <dt-bindings/tegra234-p3767-0000-common.h>

/ {
	overlay-name = "Camera IMX283-C";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;
	/* IMX283 connected to cam1 port -- 4-lane CSI */

	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				num-channels = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						rbpcv3_imx283_vi_in1: endpoint {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&rbpcv3_imx283_csi_out1>;
						};
					};
				};
			};
			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <4>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <12>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;

				modules {
					module1 {
						badge = "kurokesu_rear_283M12";
						position = "rear";
						orientation = "0";
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/rbpcv3_imx283_c@1a";
						};
					};
				};
			};
			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						num-channels = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									rbpcv3_imx283_csi_in1: endpoint@0 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&rbpcv3_imx283_out1>;
									};
								};
								port@1 {
									reg = <1>;
									rbpcv3_imx283_csi_out1: endpoint@1 {
										remote-endpoint = <&rbpcv3_imx283_vi_in1>;
									};
								};
							};
						};
					};
				};
				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
					i2c-parent = <&cam_i2c>;
					i2c@1 {
						status = "okay";
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						rbpcv3_imx283_c@1a {
							reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
							compatible = "sony,imx283";
							reg = <0x1a>;
							devnode = "video0";

							physical_w = "15.0";
							physical_h = "10.0";
							sensor_model = "imx283";

							delayed_gain = "false";
							use_decibel_gain = "false";
							use_sensor_mode_id = "true";

							mode0 { /* IMX283_MODE_5568X3648_12BIT_4LANE */
								mclk_khz = "24000";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								phy_mode = "DPHY";
								/*
								 * IMX283 emits the CSI-2 D-PHY clock
								 * in CONTINUOUS HS mode during normal
								 * streaming (per IMX283 Support
								 * Package section 4.1.3, "Escape
								 * mode": the sensor only enters ULPS
								 * on power on/off and standby).
								 * Tegra must be told the clock is
								 * continuous, otherwise NVCSI waits
								 * for HS exit/entry events that
								 * never arrive between lines and
								 * payload CRC checks fail.
								 */
								discontinuous_clk = "no";
								dpcm_enable = "false";
								/*
								 * "0" lets NVCSI auto-compute
								 * THS-SETTLE; this matches every
								 * NVIDIA reference camera DTS and is
								 * in-spec for both 1440 Mbps and the
								 * current 720 Mbps rate.
								 */
								cil_settletime = "0";
								lane_polarity = "0";

								/*
								 * 5568 = full on-wire line width:
								 * 96 non-effective pixels (HOB/OB)
								 * + 5472 effective aperture. The
								 * sensor HTRIMMING registers crop
								 * only inside the 5472-pixel area;
								 * the leading 96 HOB cols still
								 * appear on MIPI as zero-valued
								 * RAW12 pixels in every pixel line
								 * (DT 0x2C). active_w must match the
								 * on-wire width to satisfy chansel's
								 * per-line pixel counter.
								 *
								 * IMX283 Mode 0 horizontal layout
								 * (datasheet p.47):
								 *
								 *   |<- 96 non-eff -->|<-- 5472 eff -->|
								 *   | 48 HOB | 24 OB |12|12| aperture  |
								 *
								 * active_h matches Y_OUT_SIZE; both
								 * dimensions are even as Tegra VI
								 * requires. Userspace can crop the
								 * 96 leading cols at display.
								 */
								active_w = "5568";
								active_h = "3648";
								mode_type = "bayer";
								pixel_phase = "rggb";
								dynamic_pixel_bit_depth = "12";
								csi_pixel_bit_depth = "12";
								readout_orientation = "0";

								/*
								 * MIPI data rate = 720 Mbps/lane x 4 lanes
								 *                / 12 bpp = 240 Mpix/s.
								 * HTotal (line_length) x VTotal x FPS
								 *     = 6096 x 4000 x 10 = 243.8 Mpix/s
								 * (fits within 240 Mpix/s with margin).
								 *
								 * Bit rate halved from 1440 Mbps to keep
								 * the Tegra DPHY data eye open for
								 * payloads with multi-bit runs (see
								 * imx283_mode_tbls.h for the matching
								 * HS-timing register block and HMAX
								 * sizing).
								 *
								 * line_length is the H total of the
								 * Tegra-side FPS math (>= active_w);
								 * not used for per-line pixel counting.
								 *
								 * mclk_multiplier must be > pix_clk_hz/
								 * mclk = 240/24 = 10; 25 leaves ISP
								 * headroom.
								 */
								line_length = "6096";
								inherent_gain = "1";
								mclk_multiplier = "25";
								pix_clk_hz = "240000000";

								/*
								 * Gain: raw register units 0..1957.
								 * gain[dB] = -20*log10((2048 - reg) / 2048)
								 */
								gain_factor = "1";
								min_gain_val = "0";
								max_gain_val = "1957";
								step_gain_val = "1";
								default_gain = "0";

								framerate_factor = "1000000";
								min_framerate = "1000000";    /* 1 fps */
								/*
								 * max_framerate must match what the
								 * sensor can actually deliver. At
								 * HMAX=1800 the minimum frame period
								 * is HMAX * VMAX_min / 72 MHz = 1800
								 * * 3793 / 72e6 = 94.8 ms, i.e. a
								 * 10.5 fps ceiling. Advertising 11
								 * fps causes libargus to reprogram
								 * VMAX=3793 and expect frames every
								 * 90.9 ms, then tear the consumer
								 * pipeline down when the first frame
								 * arrives late.
								 */
								max_framerate = "10000000";   /* 10 fps */
								step_framerate = "1";
								default_framerate = "10000000"; /* 10 fps */

								exposure_factor = "1000000";
								min_exp_time = "50";          /* 50 us */
								max_exp_time = "49860";       /* ~49.9 ms */
								step_exp_time = "1";
								default_exp_time = "10000";   /* 10 ms */

								min_hdr_ratio = "1";
								max_hdr_ratio = "1";

								/*
								 * Pair with sensor EBD_X_OUT_SIZE = 0
								 * (see imx283_mode_tbls.h). Mismatch
								 * leaves Tegra VI's chansel waiting
								 * on an EBD line that the sensor
								 * does not emit, stalling capture.
								 */
								embedded_metadata_height = "0";
							};
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									rbpcv3_imx283_out1: endpoint {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&rbpcv3_imx283_csi_in1>;
									};
								};
							};
						};
					};
				};
				gpio@6000d000 {
					camera-control-output-low {
						gpio-hog;
						output-low;
						gpios = <CAM1_PWDN 0 CAM0_PWDN 0>;
						label = "cam1-pwdn", "cam0-pwdn";
					};
				};
			};
		};
	};
};
