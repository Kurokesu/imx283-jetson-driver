#-----------------------------------------------------
# Optical Black
#-----------------------------------------------------
# IMX283 12-bit native black level = 200; Argus normalizes manual bias to
# 10-bit scale: 200 / 4 = 50, normalized float = 50 / 1023 = 0.04887586.
opticalBlack.manualBiasR = 50;
opticalBlack.manualBiasGR = 50;
opticalBlack.manualBiasGB = 50;
opticalBlack.manualBiasB = 50;
opticalBlack.float.manualBiasR = 0.04887586;
opticalBlack.float.manualBiasGR = 0.04887586;
opticalBlack.float.manualBiasGB = 0.04887586;
opticalBlack.float.manualBiasB = 0.04887586;

